	measure 'Compair Qtty Eggs Number Grafic' = [Qtty Eggs] - [Qtty Eggs Standart]
		lineageTag: 5a2a8323-59e0-4bbd-81b5-14bc2e9b8b46

		formatStringDefinition = ```
				
				 VAR xNumber = SELECTEDMEASURE()
				        
				        VAR _Formato =
				            SWITCH(
				                TRUE(),
				                ABS(xNumber) >= 1000000, "#,##0,,.00M",
				                ABS(xNumber) >= 1000,   "#,##0,.00K",
				                "#,##0.00"
				            )
				        RETURN
				            FORMAT(xNumber, _Formato,"en-US")
				```

	measure '_Max Qtt Eggs Var' =
			
			( [_Max QTT Eggs] * 0.15 ) + _Measure[_Max QTT Eggs]
		lineageTag: 254ff2c5-b285-40e1-9fca-0bfac34ef79f

