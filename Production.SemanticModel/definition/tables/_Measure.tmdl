		displayFolder: PRD\02.%
		lineageTag: 777d9fc2-c828-415f-a4eb-3aeeffe75c8b

	measure 'STD Production Qtty' = ```
			
			--[Total Production] - ([Total Production] * [STD Mortality Percent] )
			VAR __Ofsset = 
			OFFSET(
			    1,
			    ALLSELECTED( HILL_PBI_FLOCK_STD_Semana[Week of Life] ),
			    ORDERBY( HILL_PBI_FLOCK_STD_Semana[Week of Life], DESC )
			)
			VAR __Texto = 
			CONCATENATEX( __Ofsset, [Week of Life] )
			
			VAR __Calculat = 
			CALCULATE(
			    [Qtty Birds],
			    __Ofsset )
			RETURN
			__Calculat - (__Calculat * [STD Mortality Percent] )
			```
		lineageTag: 41372f95-2f36-40b5-ae80-751de6935575

		annotation PBI_FormatHint = {"isGeneralNumber":true}

