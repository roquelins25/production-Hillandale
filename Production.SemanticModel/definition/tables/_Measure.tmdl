	measure '_Revenue Scenario' = ```
			
			VAR _Slect = SELECTEDVALUE( 'yScenario Selection'[Name] )
			
			VAR _Result = 
			SWITCH(
			    _Slect,
			    "MT", [% Mortality],
			    "EG", [% Qtty Eggs] )
			RETURN
			_Result
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: acfe63a3-a0be-405a-b1a5-f5734b9b0cd0

	measure '_Max QTT Eggs' = ```
			
			VAR vMAX = 
			CALCULATE(
			MAXX(
			    HILL_PBI_FLOCK_STD_Semana ,
			    [Qtty Eggs Standart]),
			    ALL( HILL_PBI_FLOCK_STD_Semana[Week of Life] ) )
			
			VAR _First = 
			( vMAX * 0.30 ) + vMAX
			
			VAR _FirstWeekInContext =
			    CALCULATE(
			        MIN(HILL_PBI_FLOCK_STD_Semana[Week of Life]),
			        ALLSELECTED(HILL_PBI_FLOCK_STD_Semana[Week of Life])
			    )
			VAR _FirstWeekInContext2 =
			    CALCULATE(
			        MAX(HILL_PBI_FLOCK_STD_Semana[Week of Life]),
			        ALLSELECTED(HILL_PBI_FLOCK_STD_Semana[Week of Life])
			    )
			RETURN
			
			IF( SELECTEDVALUE( HILL_PBI_FLOCK_STD_Semana[Week of Life] ) >= _FirstWeekInContext && 
			    SELECTEDVALUE( HILL_PBI_FLOCK_STD_Semana[Week of Life] ) <= _FirstWeekInContext2, _First , BLANK() )
			```
		lineageTag: 4000ab24-46d7-4b87-9975-ee585b1bb142

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'First Birds Flock' = ```
			
			VAR _First = 
			    CALCULATE(
			        FIRSTNONBLANKVALUE( HILL_PBI_FLOCK_STD_Semana[Week of Life],[Qtty Birds] ),
			        ALLSELECTED( HILL_PBI_FLOCK_STD_Semana[Week of Life] ),
			        ALL('Calendar DAX')
			    )
			VAR _FirstWeekInContext =
			    CALCULATE(
			        MIN(HILL_PBI_FLOCK_STD_Semana[Week of Life]),
			        ALLSELECTED(HILL_PBI_FLOCK_STD_Semana[Week of Life])
			    )
			VAR _FirstWeekInContext2 =
			    CALCULATE(
			        MAX(HILL_PBI_FLOCK_STD_Semana[Week of Life]),
			        ALLSELECTED(HILL_PBI_FLOCK_STD_Semana[Week of Life])
			    )
			RETURN
			
			IF( SELECTEDVALUE( HILL_PBI_FLOCK_STD_Semana[Week of Life] ) >= _FirstWeekInContext && 
			    SELECTEDVALUE( HILL_PBI_FLOCK_STD_Semana[Week of Life] ) <= _FirstWeekInContext2, _First , BLANK() )
			```
		displayFolder: PRD\01.PRD
		lineageTag: 537d715e-43c0-4e49-a39d-956e90a8c89e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

