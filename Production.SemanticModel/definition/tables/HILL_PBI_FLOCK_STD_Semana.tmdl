	partition HILL_PBI_FLOCK_STD_Semana = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("10.1.31.31", "Hillandale_Live", [Query="select#(lf)CONCAT_WS('_',Company ,[Flock No_] ) as ID_FLOCK,#(lf)CONCAT_WS('_', Company , [Flock No_] , [Week of Life] ) as ID_Week,#(lf)    [Company],#(lf)    [Flock No_],#(lf)    [Week of Life],#(lf)    [Production Date],#(lf)    [Percentage Layers],#(lf)    [Feed Consumption Animal (F)],#(lf)    [Qty_ Eggs per Female],#(lf)    [Body Weight Animal (F)],#(lf)    [Mortality Percentage Female],#(lf)    [Water Consumption],#(lf)    [Hours Light],#(lf)    [Calculated Qty_ Feed Female],#(lf)    [Calculated No_ of Animals (F)],#(lf)    [Calculated No_ of Animals (M)],#(lf)    [Calculated Qty_ Eggs],#(lf)    [Standard Qty_ Feed Female],#(lf)    [Standard No_ of Animals (F)],#(lf)    [Standard No_ of Animals (M)],#(lf)    [Standard Qty_ Eggs],#(lf)    [Standard Qty_ Water],#(lf)    [Std_ Qty_ Fertile Eggs],#(lf)    [Std_ Qty_ of Hatched Animals],#(lf)    [Standard Qty_ Culled],#(lf)    [Std_ Qty_ Hatched Animals (F)],#(lf)    [Std_ Qty_ Hatched Animals (M)],#(lf)    [Standard Qty_ Feed Male],#(lf)    [Feed Item No_]#(lf)from HILL_PBI_FLOCK_STD#(lf)where [Week Day] = 1 #(lf)#(tab)AND [Production Date] <= GETDATE()#(lf)", CommandTimeout=#duration(0, 2, 0, 0)])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

