	column consider
		dataType: string
		lineageTag: 49ba8988-10a5-48ab-9e27-e8dc9428a041
		summarizeBy: none
		sourceColumn: consider

		annotation SummarizationSetBy = Automatic

	partition HILL_PBI_FLOCK = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("10.1.31.31", "Hillandale_Live", [Query="SELECT#(lf)#(tab)CONCAT_WS('_',flock.[company],flock.[No_]) as ID_FLOCK,#(lf)#(tab)CONCAT_WS('_',flock.[Strain Code],flock.company,flock.[Strain Standard Version Code]) as StrainCod_ID,#(lf)    flock.[Order Company Name],#(lf)    flock.Company,#(lf)    flock.No_,#(lf)    flock.[Farm No_],#(lf)    flock.[Barn Code],#(lf)    flock.[Strain Code],#(lf)    flock.[Hatch Date],#(lf)    flock.[Starting Date],#(lf)    flock.[Ending Date],#(lf)    flock.[Female Item No_],#(lf)    flock.Status,#(lf)    CASE #(lf)        WHEN flock.Status = 1 THEN 'Planned'#(lf)        WHEN flock.Status = 2 THEN 'Released'#(lf)        WHEN flock.Status = 3 THEN 'Finished'#(lf)    END AS StatusName,#(lf)    flock.[Order No_],#(lf)    flock.[Strain Code],#(lf)    flock.[Strain Standard Version Code],#(lf)    barn.Name,#(lf)    barn.[Search Name],#(lf)    outp.[Housing Type Code],#(lf)    layout.Capacity,#(lf)    CASE#(lf)    #(tab)WHEN flock.[No_] = molt.[Flock No_] THEN 'N'#(lf)    #(tab)ELSE null#(lf)    END as consider#(lf)    #(lf)FROM HILL_PBI_FLOCK flock#(lf)#(lf)LEFT JOIN HILL_PBI_BARN barn #(lf)    ON barn.[Farm No_] = flock.[Farm No_]#(lf)   AND barn.Code = flock.[Barn Code]#(lf)   AND barn.[Production Type] = flock.[Type]#(lf)   AND barn.Company = flock.Company#(lf)#(lf)OUTER APPLY (#(lf)    SELECT TOP 1 *#(lf)    FROM HILL_PBI_FLOCK_OUTPUT o#(lf)    WHERE o.Company = flock.Company#(lf)      AND o.[Flock No_] = flock.[No_]#(lf)    ORDER BY o.[Starting Date] desc#(lf)) outp#(lf)#(lf)LEFT JOIN HILL_PBI_BARN_LAYOUT layout#(lf)    ON layout.[Farm No_] = flock.[Farm No_]#(lf)   AND layout.[Barn Code] = flock.[Barn Code]#(lf)   AND layout.Company = flock.Company#(lf)#(lf)LEFT JOIN HILL_PBI_FLOCK_MOLT molt ON molt.company = flock.company#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  AND molt.[Flock No_] = flock.[No_]", CommandTimeout=#duration(0, 2, 0, 0)])
				in
				    Fonte

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

