	partition 'Calendar DAX' = calculated
		mode: import
		source = ```
				
				var minAno = YEAR(MIN(HILL_PBI_FLOCK_STD_Day[Production Date]))
				var MaxAno = YEAR(MAX(HILL_PBI_FLOCK_STD_Day[Production Date]))
				return
				ADDCOLUMNS(
				    FILTER(
				        CALENDARAUTO(),
				        YEAR([Date]) >= minAno &&
				        YEAR([Date]) <= MaxAno),
				        "Year", YEAR([Date]),
				        "Month", MONTH([Date]),
				        "Name Month", FORMAT([Date],"mmmm","en-US"),
				        "Month Ab",UPPER(LEFT(FORMAT([Date], "mmm","en-US"), 1)) & LOWER(RIGHT(FORMAT([Date], "mmm","en-US"), 2)),
				        "Quarter", CONCATENATE(QUARTER([Date]),"-Quarter"),
				        "Semesters", SWITCH(
				                        TRUE(),
				                        MONTH([Date]) IN{1,2,3,4,5,6}, "1-Sem",
				                        "2-Sem"),
				        "Day",DAY([Date]),
				        "Day/Month",  FORMAT([Date],"dd-mmm","en-US") ,
				        "Day/Week",SWITCH(
				            WEEKDAY([Date]),
				            1,"Sunday",
				            2,"Monday",
				            3,"Tuesday",
				            4,"Wednesday",
				            5,"Thursday",
				            6,"Friday",
				            7,"Saturday"),
				        "Month Current", IF( YEAR( [Date] ) = YEAR( TODAY() ) && MONTH( [Date] ) = MONTH( TODAY() ), "S", "N" ),
				        "Org.Year-Month", YEAR( [Date] ) * 100 + MONTH( [Date] ),
				        "Year-Month", UPPER(LEFT(FORMAT([Date], "mmm","en-US"), 1)) & LOWER(RIGHT(FORMAT([Date], "mmm","en-US"), 2)) & "-" & YEAR( [Date] ),
				        "Year_",FORMAT( YEAR( [Date] ), "" ),
				        "MonthInic", REPT(UNICHAR(8203),12-MONTH([Date])) & UPPER(LEFT(FORMAT([Date], "mmm","en-US"), 1))
				        )
				
				```

	annotation PBI_Id = fcd8eea113a448e38c3f6d0c3c252ece

